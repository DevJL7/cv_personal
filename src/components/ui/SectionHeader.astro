---
import AnimatedReveal from '../motion/AnimatedReveal.astro';

interface Props {
  label: string;
  title: string;
  description?: string;
  id?: string;
}

const { label, title, description, id } = Astro.props;
---

<AnimatedReveal variant="fade-up">
  <header class="mb-10 max-w-2xl sm:mb-14">
    <p class="section-label mb-3 sm:mb-4">{label}</p>
    <h2
      id={id}
      class="text-2xl font-semibold tracking-tight text-foreground sm:text-3xl lg:text-4xl"
    >
      {title}
    </h2>
    {
      description && (
        <p class="mt-3 text-sm leading-relaxed text-muted sm:mt-4 sm:text-base lg:text-lg">
          {description}
        </p>
      )
    }
  </header>
</AnimatedReveal>
